<Window x:Class="VideoDownloader.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlist Downloader"
        Height="670"
        Width="900"
        FontFamily="{StaticResource PoppinsMedium}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Playlist Downloader"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>

        <!-- URL Section -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PlaylistUrlTextBox"
                     Height="40"
                     VerticalContentAlignment="Center"
                     FontSize="15"
                     Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Button x:Name="AnalyzePlaylistButton"
                        Content="Analyze"
                        Cursor="Hand"
                        Padding="10 0"
                        Click="AnalyzePlaylistButton_Click"/>

                <Button x:Name="CancelPlaylistButton"
                        Content="Cancel"
                        Cursor="Hand"
                        Width="70"
                        Margin="10 0 0 0"
                        Click="CancelPlaylistButton_Click"
                        IsEnabled="False" />

            </StackPanel>

        </Grid>

        <!-- Playlist Videos -->
        <Border Grid.Row="2"
                BorderThickness="1"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Playlist Videos"
                               FontSize="18"
                               FontWeight="Bold"/>
                    
                    <TextBlock
                           x:Name="PlaylistVideoCountTextBlock"
                           Text="--"
                           FontSize="12"
                           Margin="5 8 0 0"/>
                </StackPanel>

                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                    <Button Content="Select All"
                            Click="SelectAllButton_Click"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Padding="15,5"/>

                    <Button Content="Deselect All"
                            Cursor="Hand"
                            Click="DeselectAllButton_Click"
                            Padding="15,5"/>
                </StackPanel>


                <ListBox x:Name="PlaylistVideosListBox" Grid.Row="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{Binding IsSelected}"
                                    Content="{Binding Title}"
                                    FontSize="14"
                                    Checked="PlaylistVideoCheckBox_Changed"
                                    Unchecked="PlaylistVideoCheckBox_Changed"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding StatusText}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>

        </Border>

        <!-- Bottom Section -->
        <Grid Grid.Row="3"
              Margin="0,20,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,15">

                <TextBlock Text="Quality:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>


                <ComboBox x:Name="PlaylistQualityComboBox" Width="180"
                          SelectedIndex="0" Padding="7"
                          SelectionChanged="PlaylistQualityComboBox_SelectionChanged">
                    <ComboBoxItem Content="Best Available" />
                    <ComboBoxItem Content="Up to 2160p (4K)" />
                    <ComboBoxItem Content="Up to 1440p (2K)" />
                    <ComboBoxItem Content="Up to 1080p (FHD)" />
                    <ComboBoxItem Content="Up to 720p (HD)" />
                    <ComboBoxItem Content="Up to 480p" />
                    <ComboBoxItem Content="Up to 360p" />
                </ComboBox>


                <TextBlock Text="Save to:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="25,0,10,0"/>

                <TextBox x:Name="PlaylistSavePathTextBox" Width="300" Padding="7" IsReadOnly="True" />

                <Button Content="Choose"
                        Width="80"
                        Cursor="Hand"
                        Height="32"
                        Margin="10,0,0,0"
                        Click="ChoosePlaylistFolderButton_Click"/>

            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button 
                    x:Name="DownloadPlaylistButton"
                    Content="Download Playlist"
                    Height="45"
                    Width="200"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    IsEnabled="False"
                    Click="DownloadPlaylistButton_Click"/>

                <Button
                    x:Name="RetryFailedButton"
                    Content="Retry Failed"
                    Height="45"
                    Width="150"
                    Margin="10,0,0,0"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="RetryFailedButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,15,0,0">

                <ProgressBar x:Name="PlaylistProgressBar"
                             Height="18"
                             Minimum="0"
                             Maximum="100"/>

                <TextBlock x:Name="PlaylistStatusTextBlock"
                           Text="Ready."
                           Margin="0,8,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>