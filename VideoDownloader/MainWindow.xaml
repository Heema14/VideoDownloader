<Window x:Class="VideoDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Downloader"
        Height="670"
        Width="900"
        FontFamily="{StaticResource PoppinsMedium}"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Video Downloader"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>


        <!-- URL -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Video URL"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="UrlTextBox"
                     Height="42"
                     FontSize="16"
                     Padding="10"
                     TextWrapping="NoWrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20">

            <Button x:Name="AnalyzeButton"
                    Content="Analyze"
                    Width="130"
                    Height="42"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Click="AnalyzeButton_Click"/>

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="130"
                    Height="42"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="CancelButton_Click"/>

            <Button Content="Playlist Downloader"
                    Width="180"
                    Height="42"
                    Margin="10,0,0,0"
                    Cursor="Hand"
                    Click="PlaylistDownloaderButton_Click"/>

            <Button Content="Download History"
                    Width="160"
                    Height="42"
                    Margin="10,0,0,0"
                    Cursor="Hand"
                    Click="DownloadHistoryButton_Click"/>
        </StackPanel>


        <!-- Video information -->
        <Border Grid.Row="3"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">

            <StackPanel>
                <TextBlock Text="Video Information"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Title" FontWeight="Bold" />

                <TextBlock x:Name="TitleTextBlock"
                           Text="No video analyzed yet."
                           FontSize="18"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10"/>

                <TextBlock Text="Quality" FontWeight="Bold" />

                <ComboBox x:Name="QualityComboBox"
                          Height="40"
                          FontSize="16"
                          Padding="0 5 0 0"
                          Margin="0,5,0,10" SelectionChanged="QualityComboBox_SelectionChanged"/>

                <TextBlock Text="Save location" FontWeight="Bold" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,10">

                    <TextBox x:Name="SavePathTextBox"
                             Height="40"
                             FontSize="15"
                             Padding="8"
                             IsReadOnly="True"
                             HorizontalAlignment="Stretch"/>

                    <Button Content="Choose Folder"
                            Width="130"
                            Height="40"
                            Cursor="Hand"
                            Margin="10,0,0,0"
                            Click="ChooseFolderButton_Click"/>
                </StackPanel>


                <Button x:Name="DownloadButton"
                        Content="Download"
                        Width="180"
                        Height="45"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        IsEnabled="False"
                        Cursor="Hand"
                        Click="DownloadButton_Click"/>
            </StackPanel>
        </Border>


        <!-- Status -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="4"
                   Text="Status: Ready"
                   FontSize="15"
                   Margin="0,20,0,0"/>


        <ProgressBar x:Name="DownloadProgressBar"
                   Grid.Row="6"
                   Height="20"
                   Margin="0,10,0,0"
                   Minimum="0"
                   Maximum="100"
                   Value="0"/>
    </Grid>
</Window>